{
  "_comment": "Configuration for build.py. Everything the builder does is driven from this file.",
  "countries": [
    "pk",
    "in"
  ],
  "timeout": 10,
  "source_timeout": 60,
  "source_retries": 3,
  "stream_attempts": 2,
  "max_threads": 60,
  "max_per_host": 4,
  "batch_size": 400,
  "remove_duplicates": true,
  "sort_channels": true,
  "drop_drm_channels": true,
  "max_streams_per_channel": 3,
  "_grace_comment": "A stream is only kept after a failed probe if it verified successfully on a recent run - this absorbs a one-off CI network blip without shipping anything that has been broken for long. Set to 0 to drop a stream the moment it fails once.",
  "grace_failures": 1,
  "_geo_comment": "Keeping unverifiable streams was tried and did not work: streams hosted inside Pakistan/India that refuse connections from the CI runner turned out to be genuinely dead, not merely region-locked, and they surfaced in players as 'VLC is unable to open the MRL'. A stream now has to actually answer a probe to ship. Setting this back to true re-enables carrying unreachable South Asian streams; leave it false unless you can confirm they play for you.",
  "keep_geo_blocked": false,
  "unverifiable_max_fails": 30,
  "geo_blocked_reasons": [
    "http 403",
    "http 451",
    "http 401",
    "timeout",
    "ClientConnectorError",
    "ServerTimeoutError",
    "ConnectionTimeoutError",
    "ServerDisconnectedError"
  ],
  "geo_blocked_groups": [
    "^(Pakistani|Indian|Bangladeshi|Sri Lankan|Nepali) ",
    "^(Star|Sony|Colors|Zee) Network$",
    "^Bollywood",
    "^Sports \\(Cricket"
  ],
